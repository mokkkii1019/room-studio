# Room Studio 設定ファイルのサンプル。
# このファイルを「.env」という名前でコピーし、値を入れてください（server.py が読み込みます）。
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# 設定後は server.py を再起動（run.bat / run.sh / python server.py）。

# 楽天 商品検索API（ART OF BLACK など楽天店からの収集に必須）。https://webservice.rakuten.co.jp/ の
# 「アプリ一覧」に表示される値をそのままコピー（新仕様では APP_ID＝UUID と ACCESS_KEY の両方が必要）。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイトID（任意）。設定すると収集商品の「購入」リンクがアフィリエイトURLになります。
RAKUTEN_AFFILIATE_ID=

# 任意。楽天アプリの「許可されたWebサイト」に合わせる（既定: https://github.com/）。
# 別ドメインを許可サイトに登録した場合のみ変更。Origin は自動でこのURLのドメインから生成。
RAKUTEN_REFERER=https://github.com/

# ---- 公開サイトのベースURL（独自ドメイン移行用・任意） ----
# canonical / OGP / JSON-LD / sitemap のURLの基準。末尾スラッシュ不要。
# 未設定なら現行の https://room-studio-fawn.vercel.app にフォールバック（後方互換）。
# 独自ドメイン移行時に本番（Vercel）の環境変数へ設定する（例: https://roomstudio.jp）。
SITE_BASE_URL=

# ---- 旧ドメイン（任意・カンマ区切り） ----
# ここに挙げたホスト名で来たリクエストを SITE_BASE_URL のホストへ 308 で寄せる。
# 独自ドメインへ移った後も Vercel が最初に配った *.vercel.app のURLは生き続け、同じ
# GA4タグ入りのHTMLを返すので、計測が二重のホストに割れる（docs/GA4_ACCESS_REPORT.md §10-7）。
# 既定は移行元の room-studio-fawn.vercel.app。SITE_BASE_URL 未設定なら何もしない（ループ防止）。
# プレビュー配信（room-studio-<hash>-....vercel.app）は**対象外**＝動作確認は今までどおりできる。
LEGACY_HOSTS=room-studio-fawn.vercel.app

# ---- サーバ側AI背景切り抜き /bgcut（任意） ----
# 収集画像の背景をサーバ側で自動切り抜きする機能。onnxruntime が入っていれば有効。
# BGCUT_MODEL_URL : ISNet(quint8) モデルのダウンロード元。既定はこのリポジトリの
#                   GitHub Release アセット（tools/quantize_isnet.py で生成したもの）。
# BGCUT_MODEL_PATH: ローカルの .onnx を直接指す場合（ダウンロード省略・開発用）。
# BGCUT_MODEL_URL=
# BGCUT_MODEL_PATH=

# ---- アクセス解析 GA4（任意） ----
# 設定するとサーバーが配信時に gtag.js を注入（未設定=解析オフ）。
# 本番は Vercel の環境変数に測定IDを設定する。ローカル検証時のみ .env に置いてもよい。
GA4_ID=

# 運営の自己クリック除外（?notrack=1）の方式。未設定/0 が既定。
#   0 … 除外端末では gtag.js を読まない（何も送らない）。
#   1 … 除外端末でも GA4 にだけ traffic_type:'internal' を付けて送り、除外は GA4 の
#       「内部トラフィック」データフィルタ側で行う。除外を維持したまま UTM のテストが
#       できるようになる（0 だと何も送らないので確認しようがない）。
# ★ 1 にする前に、GA4管理画面で「内部トラフィック」の定義（IP指定）とデータフィルタを
#   作り、有効になっていることを必ず確認すること。フィルタが無いまま 1 にすると、
#   運営の自己クリックがそのままレポートに入る＝除外が完全に無効になる。
#   手順は docs/MEASUREMENT.md §7。
# GA4_INTERNAL_TRAFFIC=1

# ---- 運営者情報（法務ページの表示に使用・任意） ----
# 未設定でも既定の匿名運営者名で表示される（連絡先/住所は空なら非表示）。
# OPERATOR_NAME=
# OPERATOR_CONTACT=
# OPERATOR_ADDRESS=

# 連絡先メールアドレス（任意）。設定すると /about・/privacy・/tokushoho の問い合わせ先に出る。
# 未設定なら行ごと出ない（レイアウトは崩れない）。実アドレスはコードに書かず、ここか
# 本番（Vercel）の環境変数で与える。表示はスパム対策済み（数値文字参照＋mailto は
# クライアント側で組み立て）＝HTMLのソースに素のアドレスも mailto: も現れない。
# OPERATOR_CONTACT（自由記述）も設定されている場合は CONTACT_EMAIL が優先される。
# CONTACT_EMAIL=

# ---- 収集プロバイダの切替（フェーズ0） ----
# APP_MODE: public = 公開用。クローラ(IKEA/Shopify)は import すらされず、要求しても 403。
#           private = 自分用。クローラを選べる（自己ホスト/私的利用のみ）。
# COLLECT_PROVIDER: official = 楽天など正規APIのみ / crawler = クローラ（private時のみ有効）。
# 公開デプロイ(Vercel)は既定(public/official)のまま。ローカルで IKEA/Shopify を使うなら下記を有効化:
#   APP_MODE=private
#   COLLECT_PROVIDER=crawler
APP_MODE=public
COLLECT_PROVIDER=official
